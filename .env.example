# Copy to .env and fill in. Never commit .env.

# Images built by GitHub Actions. Use your GitHub user/org in lower case.
TAOWATCH_IMAGE_PREFIX=ghcr.io/taowatch/taowatch
# latest = main branch · sha-abc1234 = one commit · 1.2.3 = a release tag v1.2.3
TAOWATCH_TAG=latest

# Public hostname. Passkeys need HTTPS on a real domain; "localhost" works for local dev.
DOMAIN=localhost
RP_ID=localhost
RP_ORIGIN=https://localhost

# Postgres (TimescaleDB)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://taowatch:change-me@db:5432/taowatch

# Subtensor RPC. Live = every block (pruned node is fine). Archive = history backfill (rate-limited).
SUBTENSOR_WS=wss://entrypoint-finney.opentensor.ai:443
SUBTENSOR_ARCHIVE_WS=wss://archive.chain.opentensor.ai:443
BACKFILL_WORKERS=1

BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
