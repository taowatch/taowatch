# Copy to .env and fill in. Never commit .env.

# Image tag from ghcr.io/taowatch/taowatch-backend and -web.
# latest = main branch · sha-abc1234 = one commit · 1.2.3 = a release tag v1.2.3
TAOWATCH_TAG=latest

# Public URL users open (served by your nginx with TLS). Passkeys require HTTPS and RP_ID = that host.
RP_ID=taowatch.example.com
RP_ORIGIN=https://taowatch.example.com

# Who may create accounts: open (anyone who can reach the site), invite (invite code from
# the admin), closed (nobody). The first account can always be created and becomes admin.
# When unset the server uses invite.
TAOWATCH_REGISTRATION=open

# Where the web container listens for nginx (host side). Keep 127.0.0.1 unless nginx runs elsewhere.
WEB_BIND=127.0.0.1
WEB_PORT=8088

# Host folder for persistent data (Postgres in <dir>/postgres).
TAOWATCH_DATA_DIR=./data

# Postgres (TimescaleDB)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://taowatch:change-me@db:5432/taowatch

# Subtensor RPC. Live = every block (pruned node is fine).
SUBTENSOR_WS=ws://lite-finney.opentensor.xyz:9944
# Archive = history backfill. Comma-separated, tried in order: when one is rate-limited or
# times out, the next takes over. Public archives limit per IP, so keep workers at 1–2.
SUBTENSOR_ARCHIVE_WS=wss://bittensor-finney.api.onfinality.io/public-ws,wss://archive.chain.opentensor.ai:443
# One worker per wallet being backfilled.
BACKFILL_WORKERS=1

# TAO price in the status bar: Binance TAO/USDT WebSocket ticker (stored every 15 min).
# off disables it. Where stream.binance.com is unreachable use the market-data host:
#   TAOWATCH_PRICE_WS=wss://data-stream.binance.vision/ws/taousdt@ticker
TAOWATCH_PRICE=on

BIND_ADDR=0.0.0.0:8080
RUST_LOG=info
