# Plain HTTP on :80 inside the container. TLS is terminated by the reverse proxy in front
# (e.g. nginx), which must forward WebSocket upgrades for /ws.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# API + WebSocket
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /ws {
		reverse_proxy api:8080
	}

	# Single-page app
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss: ws:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
	}
}
